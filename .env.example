# Optional. If empty, configure an Agent token in the Web Console after first login.
AGENT_TOKEN=
# Set to OWNER/REPOSITORY to pull the matching published GHCR image.
GITHUB_REPOSITORY=avenlytic/avenlytic
AVENLYTIC_PORT=9080
TZ=UTC

# Optional image override, e.g. docker.io/YOUR_DOCKERHUB_USER/avenlytic:latest
AVENLYTIC_IMAGE=ghcr.io/avenlytic/avenlytic:latest
# Optional Agent image override; leave empty to derive it from GITHUB_REPOSITORY.
AVENLYTIC_AGENT_IMAGE=
# Optional. Used only with docker-compose.agent-docker.yml; point to a restricted read-only API proxy socket.
DOCKER_SOCKET_PROXY_PATH=/run/docker-ro.sock
